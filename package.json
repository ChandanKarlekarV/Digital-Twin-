{
  "name": "varuna-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npx tsx server/index.ts",
    "dev:all": "npx tsx server/index.ts & vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node start-desktop.js",
    "desktop": "node start-desktop.js",
    "test:integration": "npx tsx src/test/integration.test.ts",
    "test:voice": "npx tsx src/test/voiceParser.test.ts",
    "test:gestures": "npx tsx src/test/gestureClassifier.test.ts",
    "test:physics": "npx tsx src/physics/verifyPhysics.ts",
    "test": "npm run test:voice && npm run test:gestures && npm run test:physics && npm run test:integration",
    "convert:model": "node --max-old-space-size=8192 scripts/convert-rig-model.mjs",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/hands": "0.4.1675469240",
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.14",
    "katex": "^0.16.11",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.173.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
